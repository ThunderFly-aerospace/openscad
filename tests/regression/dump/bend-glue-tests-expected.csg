bend($fn = 16, $fa = 12, $fs = 2, at = 15, r = 2, angle = 90, zlim = [undef, 0.45]) {
	group() {
		cube(size = [40, 6, 0.4], center = false);
		multmatrix([[1, 0, 0, 16], [0, 1, 0, 1], [0, 0, 1, 0.5], [0, 0, 0, 1]]) {
			cube(size = [8, 4, 3], center = false);
		}
	}
}
multmatrix([[1, 0, 0, 0], [0, 1, 0, 10], [0, 0, 1, 0], [0, 0, 0, 1]]) {
	bend($fn = 16, $fa = 12, $fs = 2, at = 15, r = 2, angle = 90, zlim = [undef, 0.45], glue = 0.2) {
		group() {
			cube(size = [40, 6, 0.4], center = false);
			multmatrix([[1, 0, 0, 16], [0, 1, 0, 1], [0, 0, 1, 0.5], [0, 0, 0, 1]]) {
				cube(size = [8, 4, 3], center = false);
			}
		}
	}
}
