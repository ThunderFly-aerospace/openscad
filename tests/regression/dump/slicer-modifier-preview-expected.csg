color([1, 0.843137, 0, 1]) {
	cube(size = [40, 40, 10], center = false);
}
multmatrix([[1, 0, 0, 10], [0, 1, 0, 10], [0, 0, 1, -2], [0, 0, 0, 1]]) {
	slicer_modifier(type = "modifier", color = [1, 0, 0, 1], fill_density = "80%") {
		group() {
			cylinder($fn = 32, $fa = 12, $fs = 2, h = 20, r1 = 6, r2 = 6, center = false);
		}
	}
}
slicer_modifier(type = "modifier", perimeters = "4") {
	group() {
		multmatrix([[1, 0, 0, 25], [0, 1, 0, -5], [0, 0, 1, 5], [0, 0, 0, 1]]) {
			cube(size = [10, 20, 10], center = false);
		}
	}
}
slicer_modifier(type = "modifier", color = [0, 0, 1, 1]) {
	group() {
		multmatrix([[1, 0, 0, 28], [0, 1, 0, 25], [0, 0, 1, 0], [0, 0, 0, 1]]) {
			cube(size = [8, 20, 20], center = false);
		}
	}
}
